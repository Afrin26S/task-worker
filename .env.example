# ---- Option A: Anthropic (default if ANTHROPIC_API_KEY is set)
ANTHROPIC_API_KEY=your-key-here
LLM_MODEL=claude-sonnet-5-5

# ---- Option B: any OpenAI-compatible endpoint (OpenAI, Gemini, Groq, OpenRouter, local Ollama ...)
# LLM_PROVIDER=openai
# LLM_API_KEY=your-key-here
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   # example: Gemini. OpenAI default: https://api.openai.com/v1
# LLM_MODEL=gemini-2.5-flash                                              # use a current model name from your provider's docs
